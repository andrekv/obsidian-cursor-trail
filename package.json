{
  "name": "obsidian-cursor-trail",
  "version": "1.0.0",
  "description": "Provides a high-visibility block cursor and a Kitty-like movement trail for the Obsidian editor.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "cursor",
    "aesthetics"
  ],
  "author": "andrekv",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/node": "^16.11.21",
    "@typescript-eslint/eslint-plugin": "^5.10.1",
    "@typescript-eslint/parser": "^5.10.1",
    "builtin-modules": "^3.2.0",
    "esbuild": "0.14.14",
    "obsidian": "latest",
    "tslib": "2.3.1",
    "typescript": "4.5.5"
  }
}
